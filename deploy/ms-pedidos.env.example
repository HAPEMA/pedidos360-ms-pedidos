# Copiar a /etc/pedidos360/ms-pedidos.env (chmod 600, dueño root) y completar con valores reales.
# Este archivo de ejemplo NO contiene secretos.

PORT=8082

# RDS PostgreSQL
DB_URL=jdbc:postgresql://mi-instancia.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com:5432/pedidos360
DB_USER=pedidos_app
DB_PASS=cambiar-por-la-clave-real

# ms-catalogo corre en la misma instancia EC2
CATALOGO_URL=http://localhost:8081

# Amazon Cognito (us-east-1)
COGNITO_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Origen exacto del front (sin barra final)
FRONT_ORIGIN=https://front.ejemplo.com
