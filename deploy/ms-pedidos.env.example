# Copiar a /etc/pedidos360/ms-pedidos.env y reemplazar cada REEMPLAZAR_EN_EC2 por el valor real.
# sudo chmod 600 /etc/pedidos360/ms-pedidos.env  (el archivo real contiene secretos)

PORT=8082

# RDS PostgreSQL
DB_URL=jdbc:postgresql://pedidos360-db.cdsrcop1stid.us-east-1.rds.amazonaws.com:5432/pedidos_db
DB_USER=postgres
DB_PASS=REEMPLAZAR_EN_EC2

# ms-catalogo corre en la misma instancia EC2
CATALOGO_URL=http://localhost:8081

# Amazon Cognito (us-east-1)
COGNITO_POOL_ID=us-east-1_yJTuOqej9
COGNITO_CLIENT_ID=55g18pciai9kmgp5818ta6ur28

# Origen exacto del front (sin barra final).
# Cambiar por la URL de CloudFront cuando exista.
FRONT_ORIGIN=http://localhost:4200

# URL del issuer del User Pool (sin barra final). Reemplaza a COGNITO_POOL_ID cuando se define.
# COGNITO_ISSUER_URI=https://cognito-idp.<region>.amazonaws.com/<userPoolId>
