# Maven
target/
!.mvn/wrapper/maven-wrapper.jar

# IDEs
.idea/
*.iml
*.ipr
*.iws
.vscode/
.classpath
.project
.settings/
.factorypath
.sts4-cache/
nbproject/

# Sistema operativo
.DS_Store
Thumbs.db

# Variables de entorno (nunca secretos en el repo)
.env
*.env
!*.env.example
.env.local

# Llaves SSH / certificados
*.pem

# Logs
*.log

# Configuración local: un application-local.* NUEVO nunca se sube por accidente (puede llevar IDs o claves).
# Los application-local.properties que ya están versionados (H2 + placeholders, los usan los tests con
# @ActiveProfiles("local")) siguen rastreados: git no ignora archivos que ya están en el índice.
application-local.*
